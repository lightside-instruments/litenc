#!/usr/bin/python

# Usage: set-net input-xml-file [output-xml-file]
# Optionally saves the updated topology with access statistics after commit.

import lxml
from lxml import etree
import time
import sys, os
from copy import deepcopy
import tntapi

namespaces={"nc":"urn:ietf:params:xml:ns:netconf:base:1.0",
	"nd":"urn:ietf:params:xml:ns:yang:ietf-network",
	"netconf-node":"urn:tntapi:netconf-node"}


def main():

	tree=etree.parse(sys.argv[1])
	orig_tree=tree

	network = tree.xpath('/nc:config/nd:networks/nd:network', namespaces=namespaces)[0]
	conns = tntapi.network_connect(network, access_statistics_results_network=network)

	assert(conns != None)

	for conn_id in conns:
		print (conn_id)

		inst_id="/nc:config/nd:networks/nd:network/nd:node[nd:node-id='%s']/netconf-node:config"%(conn_id)
		print (inst_id)
		config = orig_tree.xpath(inst_id,namespaces=namespaces)[0]
		print( lxml.etree.tostring(config))
		netconf_config=lxml.etree.Element("{urn:ietf:params:xml:ns:netconf:base:1.0}config", nsmap=namespaces)
		for child in config:
			netconf_config.append( deepcopy(child) )

		tntapi.copy_config(conns[conn_id],lxml.etree.tostring(netconf_config), access_statistics_results_node=config.getparent())


	tntapi.network_commit(conns, access_statistics_results_network=network)
	if len(sys.argv) > 2:
		tree.write(sys.argv[2], xml_declaration=True, encoding=tree.docinfo.encoding or "UTF-8")
	return 0

sys.exit(main())

